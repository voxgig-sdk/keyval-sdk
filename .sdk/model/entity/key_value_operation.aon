      "key"
      "value"
    ]
    sep: "/"
  }

  name: "key_value_operation"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "mykey"
                kind: "param"
                name: "key"
                orig: "key"
                reqd: true
                type: "`$STRING`"
              }
