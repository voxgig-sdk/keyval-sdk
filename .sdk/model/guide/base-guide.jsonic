# Guide

guide: {
  metrics: count: entity: 2
  metrics: count: path: 3
  metrics: count: method: 3

  entity: key_value_operation: {
    path: "/get/{key}": {
      op: load: method: *GET
    }
    path: "/set/{key}/{value}": {
      op: load: method: *GET
    }
  }

  entity: nt: {
    path: "/-/{value}": {
      op: load: method: *GET
    }
  }

}