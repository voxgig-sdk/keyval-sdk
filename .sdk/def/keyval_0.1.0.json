{
  "openapi": "3.0.3",
  "info": {
    "title": "KeyVal API",
    "description": "A super simple key value database with APIs for setting and getting key/value pairs.\n\nGET /set/{key}/{value} and GET /-/{value} are left out: they store data through GET, so no SDK test, live or offline, should call them, and a GET-only guard cannot tell them from reads.",
    "version": "1.0.0",
    "contact": {
      "url": "https://keyval.org"
    }
  },
  "servers": [
    {
      "url": "https://api.keyval.org",
      "description": "Production server"
    }
  ],
  "paths": {
    "/get/{key}": {
      "get": {
        "summary": "Get a value by key",
        "description": "Retrieves the value associated with the specified key from the database.",
        "operationId": "getValueByKey",
        "tags": [
          "Key-Value Operations"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The key to retrieve the value for.",
            "schema": {
              "type": "string"
            },
            "example": "mykey"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the value",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "The requested key"
                    },
                    "value": {
                      "type": "string",
                      "description": "The value associated with the key"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid key"
          },
          "404": {
            "description": "Key not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Key-Value Operations",
      "description": "Operations for storing and retrieving key-value pairs"
    }
  ]
}
