{
  "openapi": "3.0.3",
  "info": {
    "title": "KeyVal API",
    "description": "A super simple key value database with APIs for setting and getting key/value pairs.",
    "version": "1.0.0",
    "contact": {
      "url": "https://keyval.org"
    }
  },
  "servers": [
    {
      "url": "https://api.keyval.org",
      "description": "Production server"
    }
  ],
  "paths": {
    "/set/{key}/{value}": {
      "get": {
        "summary": "Set a key/value pair",
        "description": "Sets a key/value pair in the database. Returns the stored key and value.",
        "operationId": "setKeyValue",
        "tags": [
          "Key-Value Operations"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The key to store. Use '-' to auto-generate a key.",
            "schema": {
              "type": "string"
            },
            "example": "mykey"
          },
          {
            "name": "value",
            "in": "path",
            "required": true,
            "description": "The value to store for the specified key.",
            "schema": {
              "type": "string"
            },
            "example": "myvalue"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully stored the key/value pair",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "The key that was stored (auto-generated if '-' was used)"
                    },
                    "value": {
                      "type": "string",
                      "description": "The value that was stored"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid key or value"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/-/{value}": {
      "get": {
        "summary": "Set a value with auto-generated key",
        "description": "Sets a value with an auto-generated key. The key will be automatically generated by the system.",
        "operationId": "setAutoGeneratedKey",
        "tags": [
          "Key-Value Operations"
        ],
        "parameters": [
          {
            "name": "value",
            "in": "path",
            "required": true,
            "description": "The value to store with an auto-generated key.",
            "schema": {
              "type": "string"
            },
            "example": "myvalue"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully stored the value with an auto-generated key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "The auto-generated key"
                    },
                    "value": {
                      "type": "string",
                      "description": "The value that was stored"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid value"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/get/{key}": {
      "get": {
        "summary": "Get a value by key",
        "description": "Retrieves the value associated with the specified key from the database.",
        "operationId": "getValueByKey",
        "tags": [
          "Key-Value Operations"
        ],
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "description": "The key to retrieve the value for.",
            "schema": {
              "type": "string"
            },
            "example": "mykey"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the value",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "The requested key"
                    },
                    "value": {
                      "type": "string",
                      "description": "The value associated with the key"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid key"
          },
          "404": {
            "description": "Key not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Key-Value Operations",
      "description": "Operations for storing and retrieving key-value pairs"
    }
  ]
}
